# Copie este arquivo para .env e preencha. O .env NUNCA vai para o GitHub.

# Chave secreta (gere com: python -c "import secrets; print(secrets.token_urlsafe(48))")
# Ela também protege o token do Mercado Pago guardado no banco: não troque depois de configurar.
SECRET_KEY=

# dev (computador local) ou production (servidor com HTTPS)
APP_ENV=dev

# Endereço público do site (em produção, obrigatório https://)
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Atrás de um proxy/hospedagem (Render, Railway etc.) use 1
TRUST_PROXY=0

# E-mail de contato usado na busca de endereços do OpenStreetMap
CONTACT_EMAIL=

# Usuário do painel criado na hospedagem (só se ainda não existir nenhum). Senha: 10+ caracteres com maiúsculas, minúsculas e números.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Onde ficam o banco e as fotos (padrão: pasta instance/)
# DATABASE_PATH=
# UPLOAD_DIR=

# ---------- Mercado Pago (opcional) ----------
# O normal é conectar pelo painel (menu Pagamentos). Se preencher aqui, fica TRAVADO pelo servidor.
MP_ACCESS_TOKEN=
MP_SANDBOX=1
MP_WEBHOOK_SECRET=
PIX_PAYER_FALLBACK_EMAIL=cliente@numelhor.com.br
